# Every setting LeadFlow uses. Copy to .env and change the values:
#   cp .env.example .env
# docker-compose.yml reads this file. For running without Docker,
# backend/.env.example and frontend/.env.example hold the same keys.

# --- Database (Docker Compose) ---
# Postgres user, password and database name for the `db` container.
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadflow

# --- Backend ---
# SQLAlchemy URL. Docker Compose builds the Postgres URL itself from the values
# above; this one is for running the API without Docker (SQLite file).
DATABASE_URL=sqlite:///./leadflow.db
# Comma-separated origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:3000
# Seed demo data when the API starts and the database is empty (true/false).
SEED_ON_STARTUP=true
# Timezone the seed script uses to decide "today" (e.g. Asia/Kolkata). The app
# itself always shows times in the browser's timezone.
TZ=UTC

# --- Frontend ---
# Base URL of the API as the browser sees it. Baked in when the frontend is built.
NEXT_PUBLIC_API_URL=http://localhost:8000
